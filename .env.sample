# Copy this file to .env and fill it in. Never commit .env.

# --- Database (MySQL 8 / MariaDB) ------------------------------------------------
# Local XAMPP defaults: root with an empty password. `npm run db:setup` creates DB_NAME if it doesn't exist.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=casigurotest
# Port of the MySQL server (default 3306). Hosted databases use their own: copy it from the provider (Aiven shows it
# on the service's Overview page next to Host).
DB_PORT=3306

# SSL, required by hosted databases like Aiven. Leave both blank for local XAMPP.
# DB_SSL_CA: path to the provider's CA certificate (relative to backend/), e.g. certs/ca.pem. Aiven: Overview page →
# "CA certificate" → Download. You can also paste the PEM text itself (with \n for line breaks) when your host only
# takes env values.
DB_SSL_CA=
# DB_SSL=true encrypts without verifying the server. Only if you can't supply the CA certificate.
DB_SSL=

# Time zone of every database session (default +08:00, Manila). SOA numbers and dates come from the database clock,
# and hosted servers run in UTC, so leave this as it is.
DB_TIMEZONE=+08:00

# --- Server ---------------------------------------------------------------------
# development (default) or production. Production makes the login cookie Secure + SameSite=None (needs HTTPS, works
# when the frontend is on another domain) and refuses to start with a JWT_SECRET shorter than 32 characters.
NODE_ENV=development

# Port the API listens on. Not the database port (that is DB_PORT).
PORT=5000
# Production: 127.0.0.1, so the API is only reachable through the reverse proxy (Caddy). Blank = all interfaces.
HOST=

# Set to loopback when Caddy/Nginx on the same machine forwards requests, so audit logs record the visitor's IP
# instead of 127.0.0.1. Leave blank when there is no proxy (local development).
TRUST_PROXY=

# Secret that signs login tokens. Use a long random value, different for every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Frontend address allowed to call the API (CORS and live updates), no trailing slash. Several: separate with commas.
# Defaults to http://localhost:5173 when unset. In production: the Vercel URL, e.g. https://casiguro.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional: login cookie SameSite (strict | lax | none). Default: none in production, strict in development.
# Use strict or lax only if the frontend and API share a site (e.g. app.example.com + api.example.com).
COOKIE_SAMESITE=

# Optional: close the PDF browser (Chrome) after this many ms without a quotation PDF, to free memory. Default 300000
# (5 min). 0 keeps it open.
PDF_BROWSER_IDLE_MS=

# --- Email (sign-up and password reset codes, account notices) -------------------
# Leave everything blank during development: the codes are printed to the server console instead.
MAIL_FROM_NAME=Casiguro Enterprises

# The first option that is filled in is used.

# The Gmail address the emails are sent from (Gmail API and Gmail SMTP).
MAIL_USER=

# Option A, production: Gmail API. Sends over HTTPS (works on DigitalOcean, which blocks SMTP), no domain needed.
# Client ID/secret from a Google Cloud OAuth client of type "Desktop app"; then run `npm run gmail:auth` on your PC,
# sign in as MAIL_USER, and paste the printed refresh token. Steps: DEPLOYMENT.md, "Email with the Gmail API".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option B, local development: Gmail SMTP with a Google App Password (needs 2-Step Verification). Blocked on
# DigitalOcean droplets.
MAIL_APP_PASSWORD=

# Option C, only with a domain of your own: Resend (https://resend.com). Takes priority over A and B when set.
# MAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=
